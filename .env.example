# =========================
# Enterprise Offline AI Ecosystem
# Example Environment File
# =========================
# Copy this file to .env and update values based on your runtime mode.
# Do NOT put real secrets in .env.example.

# =========================
# API Settings
# =========================
API_HOST=0.0.0.0
API_PORT=8001
API_DEV_MODE=false
API_RELOAD=false

# =========================
# Ollama Settings
# =========================
# For local scripts on host machine:
OLLAMA_BASE_URL=http://localhost:11434

# For Docker API hybrid mode, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# =========================
# LLM Backend
# =========================
LLM_BACKEND=ollama
VLLM_BASE_URL=http://127.0.0.1:8002/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=
VLLM_TIMEOUT_SECONDS=300

# =========================
# ChromaDB Settings
# =========================
# For local scripts on host machine:
CHROMA_HOST=localhost
CHROMA_PORT=8000

# For Docker API hybrid mode, use:
# CHROMA_HOST=host.docker.internal
# CHROMA_PORT=8000

CHROMA_COLLECTION=documents

# =========================
# Models
# =========================
GENERAL_GENERATION_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text

# =========================
# RAG Settings
# =========================
# Re-ingest PDFs after changing chunking settings or RAG_INDEX_VERSION.
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=180

# =========================
# Performance / Concurrency
# =========================
MAX_CONCURRENT_LLM_REQUESTS=2
MAX_WAITING_RAG_REQUESTS=20
MAX_QUEUE_WAIT_SECONDS=45

# =========================
# Ollama Runtime
# =========================
OLLAMA_KEEP_ALIVE=30m
MODEL_NUM_CTX=4096
MODEL_NUM_BATCH=64
MODEL_NUM_THREAD=8
MODEL_TEMPERATURE=0.2
MODEL_NUM_PREDICT=512

# =========================
# Ollama Warm-up
# =========================
WARMUP_ON_STARTUP=false
WARMUP_TIMEOUT_SECONDS=60
WARMUP_GENERATION_MODEL=true
WARMUP_EMBEDDING_MODEL=true

# =========================
# Cache Settings
# =========================
RAG_RETRIEVAL_CACHE_ENABLED=true
RAG_RESPONSE_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=600
RAG_CACHE_MAX_ITEMS=500
RAG_INDEX_VERSION=chunking-v2
RAG_PROMPT_VERSION=v1

# =========================
# Background Jobs
# =========================
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_WORKERS=1
BACKGROUND_JOB_MAX_QUEUE=20
BACKGROUND_JOB_RETENTION_SECONDS=86400

# =========================
# Documents / Data Paths
# =========================
DOCS_DIR=data/docs
CHAT_LOG_PATH=data/chat_history.jsonl

# =========================
# API Protection
# =========================
INGEST_PROTECTION_ENABLED=true
INGEST_API_KEY=change-me-ingest-key
INGEST_API_KEY_HEADER=X-API-Key

# Admin endpoints:
# Used for migrate-chat-history and ingest-chat-history API endpoints.
ADMIN_API_KEY=change-me-admin-key
ADMIN_API_KEY_HEADER=X-API-Key

# =========================
# Health / Debug
# =========================
HEALTH_INCLUDE_ERROR_DETAILS=false
